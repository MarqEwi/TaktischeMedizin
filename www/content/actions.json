                "op": "controlState",
                "stateId": "massive_extremity_bleeding"
              },
              {
                "op": "addTag",
                "tag": "tq_angelegt"
              }
            ],
            "feedback": "Tourniquet sitzt – die massive Blutung steht.",
            "quality": "correct"
          },
          {
            "if": {
              "stateActive": "moderate_bleeding",
              "minSeverity": 1
            },
            "apply": [
              {
                "op": "controlState",
                "stateId": "moderate_bleeding"
              },
              {
                "op": "addTag",
                "tag": "tq_angelegt"
              }
            ],
            "feedback": "Die Blutung steht – für diese Wunde wäre allerdings ein Druckverband ausreichend und schonender gewesen.",
            "quality": "partial"
          },
          {
            "if": null,
            "apply": [],
            "feedback": "Kein sinnvoller Ansatzpunkt – es ist keine relevante Extremitätenblutung erkennbar.",
            "quality": "unnecessary"
          }
        ]
      }
